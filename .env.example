# FinSmart Local Development - Environment Configuration

# Database Backend: 'mssql' or 'postgresql'
DB_BACKEND=mssql

# SQL Server Configuration
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=FinSmartDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPassword

# PostgreSQL Configuration (use if DB_BACKEND=postgresql)
# DATABASE_URL=postgresql://user:password@localhost:5432/finsmart

# Django Settings
DEBUG=True
SESSION_SECRET=your-secret-key-here-32-characters-minimum

# Groq AI API
GROQ_API_KEY=gsk_your_api_key_here
